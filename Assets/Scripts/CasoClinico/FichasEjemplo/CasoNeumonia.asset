%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoNeumonia
  m_EditorClassIdentifier: 
  idCaso: CASO-NAC
  nombreCaso: "Neumon\xEDa adquirida en la comunidad"
  motivoConsulta: Tengo fiebre alta, me cuesta respirar y tengo un dolor fuerte en
    el pecho al respirar hondo.
  antecedentesRelevantes:
  - "Adulto mayor (o inmunosupresi\xF3n)."
  - EPOC previo / tabaquismo.
  - "Sin hospitalizaci\xF3n reciente (neumon\xEDa de la comunidad)."
  signosVitales:
    frecuenciaCardiaca: 112
    frecuenciaRespiratoria: 28
    presionArterial: 105/68
    saturacionO2: 90
    temperatura: 39.1
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: "Sin adenopat\xEDas relevantes."
    esHallazgoRelevante: 0
  - regionAnatomica: "T\xF3rax anterior"
    hallazgoTexto: "Cr\xE9pitos localizados, murmullo disminuido en la zona afectada."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax posterior"
    hallazgoTexto: "Matidez y broncofon\xEDa/egofon\xEDa en la zona de consolidaci\xF3n."
    esHallazgoRelevante: 1
  - regionAnatomica: Precordio
    hallazgoTexto: Taquicardia.
    esHallazgoRelevante: 1
  - regionAnatomica: Abdomen
    hallazgoTexto: "Sin hallazgos relevantes (posible dolor referido si la base derecha
      est\xE1 comprometida)."
    esHallazgoRelevante: 0
  - regionAnatomica: Extremidades
    hallazgoTexto: Sin edema; posible cianosis distal si hay hipoxemia severa.
    esHallazgoRelevante: 0
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: Piel caliente y sudorosa; cianosis peribucal si el cuadro es grave.
    esHallazgoRelevante: 1
  examenesDisponibles:
  - nombreExamen: "Radiograf\xEDa de t\xF3rax"
    resultado: "Consolidaci\xF3n con broncograma a\xE9reo en l\xF3bulo inferior derecho."
    clasificacion: 1
  - nombreExamen: Hemograma
    resultado: "Leucocitosis con desviaci\xF3n a izquierda."
    clasificacion: 1
  - nombreExamen: "Cultivo de expectoraci\xF3n"
    resultado: "Pendiente / positivo seg\xFAn el agente causal."
    clasificacion: 1
  - nombreExamen: "Prote\xEDna C reactiva"
    resultado: Elevada (aprox. 120 mg/L).
    clasificacion: 2
  - nombreExamen: Gases arteriales
    resultado: Hipoxemia leve (PaO2 aprox. 62 mmHg), pH normal.
    clasificacion: 2
  - nombreExamen: "Exploraci\xF3n cl\xEDnica del dolor"
    resultado: "Dolor pleur\xEDtico al inspirar (EVA 4/10)."
    clasificacion: 2
  preguntasClave:
  - idPregunta: nac_inicio_fiebre
    preguntaSugerida: "\xBFHace cu\xE1nto tiene fiebre?"
    conjuntosPalabrasClave:
    - palabras:
      - hace
      - fiebr
    - palabras:
      - desde
      - fiebr
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Desde ayer, muy alta, con calofr\xEDos."
    esPreguntaClave: 1
    intencionesQueSatisface:
    - tiempo_evolucion
  - idPregunta: nac_tos_productiva
    preguntaSugerida: "\xBFTiene tos? \xBFCon flema?"
    conjuntosPalabrasClave:
    - palabras:
      - tos
      - flem
    - palabras:
      - flem
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, con flema amarillo-verdosa."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: nac_dolor_pleuritico
    preguntaSugerida: "\xBFLe duele el pecho al respirar o toser?"
    conjuntosPalabrasClave:
    - palabras:
      - dol
      - pecho
    - palabras:
      - punzante
    - palabras:
      - duel
      - pecho
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, un dolor punzante de este lado."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: nac_disnea
    preguntaSugerida: "\xBFLe cuesta respirar?"
    conjuntosPalabrasClave:
    - palabras:
      - cuesta
      - respir
    - palabras:
      - falta
      - aire
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, respiro r\xE1pido y corto."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: nac_contacto
    preguntaSugerida: "\xBFHa tenido contacto con alguien enfermo?"
    conjuntosPalabrasClave:
    - palabras:
      - contact
      - enferm
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: No que yo sepa.
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: nac_comorbilidad
    preguntaSugerida: "\xBFTiene alguna enfermedad cr\xF3nica?"
    conjuntosPalabrasClave:
    - palabras:
      - enfermedad
      - cronic
    - palabras:
      - epoc
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: Tengo EPOC.
    esPreguntaClave: 1
    intencionesQueSatisface: []
  respuestaGenericaSinMatch: "Disculpe, no le entend\xED bien. \xBFMe lo puede preguntar
    de otra forma?"
  historia:
    inicio: "Desde ayer, con fiebre muy alta y calofr\xEDos."
    evolucion: No refiere
    empeora: "Me duele m\xE1s cuando respiro hondo."
    alivia: No refiere
    remedios: No refiere
    alergias: No refiere
    antecedentes: Tengo EPOC y no he estado hospitalizado hace poco.
    habitos: No refiere
    intensidad: Tengo un dolor fuerte en el pecho y la fiebre es muy alta.
    localizacion: Un dolor punzante en el pecho, de este lado.
    sintomasAsociados: "Tengo tos con flema amarillo-verdosa, calofr\xEDos y respiro
      r\xE1pido y corto."
    perfil: "Soy Eduardo Fern\xE1ndez, tengo 72 a\xF1os."
  diagnosticoEsperado: "Neumon\xEDa adquirida en la comunidad."
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - neumonia
  - palabras:
    - neumonia
    - comunidad
  - palabras:
    - pulmonia
  accionesCriticas:
  - descripcion: Posicionar en semifowler e iniciar oxigenoterapia si hay hipoxemia
    tipo: 4
    idReferencia: manejo_semifowler_o2
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - oxigen
      - fowler
    - palabras:
      - oxigen
      - semisent
    - palabras:
      - oxigen
      - sentad
    - palabras:
      - oxigen
      - sentar
    - palabras:
      - oxigen
      - incorpor
    - palabras:
      - oxigen
      - cabecera
    - palabras:
      - o2
      - fowler
    - palabras:
      - o2
      - semisent
    - palabras:
      - o2
      - sentad
    - palabras:
      - o2
      - sentar
    - palabras:
      - o2
      - incorpor
    - palabras:
      - o2
      - cabecera
  - descripcion: "Reconocer signos de gravedad (confusi\xF3n, hipotensi\xF3n, taquipnea
      severa)"
    tipo: 4
    idReferencia: manejo_reconocer_gravedad
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - gravedad
    - palabras:
      - curb
    - palabras:
      - hospitaliz
    - palabras:
      - cuidados
      - intensiv
    - palabras:
      - unidad
      - critic
  erroresFrecuentes:
  - descripcion: No auscultar comparativamente ambos campos pulmonares
    idReferenciaCondicion: "omitio:T\xF3rax anterior"
    retroalimentacion: "La comparaci\xF3n entre ambos hemit\xF3rax hace evidente
      la asimetr\xEDa del murmullo y localiza la consolidaci\xF3n."
  - descripcion: "Omitir preguntar por dolor pleur\xEDtico"
    idReferenciaCondicion: omitio:nac_dolor_pleuritico
    retroalimentacion: "El dolor que aumenta con la inspiraci\xF3n profunda orienta
      a compromiso pleural por la consolidaci\xF3n."
  - descripcion: "No solicitar la radiograf\xEDa de t\xF3rax"
    idReferenciaCondicion: "omitio:Radiograf\xEDa de t\xF3rax"
    retroalimentacion: "La radiograf\xEDa confirma la consolidaci\xF3n y es el examen
      de referencia para el diagn\xF3stico."
  - descripcion: No solicitar hemograma
    idReferenciaCondicion: omitio:Hemograma
    retroalimentacion: "La leucocitosis con desviaci\xF3n a izquierda apoya el origen
      bacteriano y ayuda a la estratificaci\xF3n."
  datosAdministrativos:
    nombrePacienteFicticio: "Fern\xE1ndez Soto, Eduardo"
    sexoPaciente: Masculino
    edadPaciente: "72 a\xF1os"
    nombreEstablecimiento: "Hospital Regional Simulado \u2014 Servicio de Urgencias"
