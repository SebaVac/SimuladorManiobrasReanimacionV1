%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoTBC
  m_EditorClassIdentifier:
  idCaso: CASO-TBC
  nombreCaso: 'Tuberculosis pulmonar'
  motivoConsulta: 'Llevo varias semanas con una tos que no se me quita, y he bajado de peso sin querer.'
  antecedentesRelevantes:
  - 'Contacto reciente con persona con TBC confirmada.'
  - 'Hacinamiento en el domicilio.'
  - 'Sin antecedente documentado de vacunación BCG.'
  signosVitales:
    frecuenciaCardiaca: 95
    frecuenciaRespiratoria: 20
    presionArterial: 110/70
    saturacionO2: 96
    temperatura: 37.8
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: 'Adenopatías cervicales palpables, no dolorosas.'
    esHallazgoRelevante: 1
  - regionAnatomica: Tórax anterior
    hallazgoTexto: 'Murmullo pulmonar disminuido en los vértices.'
    esHallazgoRelevante: 1
  - regionAnatomica: Tórax posterior
    hallazgoTexto: 'Crépitos en los vértices, matidez apical.'
    esHallazgoRelevante: 1
  - regionAnatomica: Precordio
    hallazgoTexto: 'Sin alteraciones.'
    esHallazgoRelevante: 0
  - regionAnatomica: Abdomen
    hallazgoTexto: 'Sin hallazgos relevantes.'
    esHallazgoRelevante: 0
  - regionAnatomica: Extremidades
    hallazgoTexto: 'Pérdida de masa muscular, aspecto caquéctico.'
    esHallazgoRelevante: 1
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: 'Palidez, mucosas secas; refiere sudoración nocturna.'
    esHallazgoRelevante: 1
  examenesDisponibles:
  - nombreExamen: 'Baciloscopia de esputo'
    resultado: 'Positiva (++), presencia de bacilos ácido-alcohol resistentes.'
    esExamenPertinente: 1
  - nombreExamen: 'Cultivo de esputo'
    resultado: 'Positivo para Mycobacterium tuberculosis (resultado diferido).'
    esExamenPertinente: 1
  - nombreExamen: 'Radiografía de tórax'
    resultado: 'Infiltrado cavitado en lóbulo superior derecho.'
    esExamenPertinente: 1
  - nombreExamen: 'PPD (derivado proteico purificado)'
    resultado: 'Induración >15 mm, positiva.'
    esExamenPertinente: 1
  preguntasClave:
  - idPregunta: tbc_hemoptisis
    preguntaSugerida: '¿Ha notado sangre en el esputo?'
    conjuntosPalabrasClave:
    - palabras:
      - sangre
      - tos
    - palabras:
      - sangre
      - esputo
    - palabras:
      - sangre
      - flem
    - palabras:
      - hemoptisis
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: 'Sí, un par de veces vi como hilos de sangre.'
    esPreguntaClave: 1
  - idPregunta: tbc_duracion_tos
    preguntaSugerida: '¿Cuánto tiempo lleva con tos?'
    conjuntosPalabrasClave:
    - palabras:
      - cuanto
      - tos
    - palabras:
      - hace
      - tos
    - palabras:
      - tiempo
      - tos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: 'Como tres semanas; antes era seca y ahora sale con flema.'
    esPreguntaClave: 1
  - idPregunta: tbc_baja_peso
    preguntaSugerida: '¿Ha bajado de peso?'
    conjuntosPalabrasClave:
    - palabras:
      - baj
      - peso
    - palabras:
      - adelgaz
    - palabras:
      - kilos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: 'Sí, unos cinco kilos sin hacer dieta.'
    esPreguntaClave: 1
  - idPregunta: tbc_sudor_nocturno
    preguntaSugerida: '¿Suda en la noche?'
    conjuntosPalabrasClave:
    - palabras:
      - sud
      - noch
    - palabras:
      - empap
      - saban
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: 'Sí, a veces empapo las sábanas.'
    esPreguntaClave: 1
  - idPregunta: tbc_contacto
    preguntaSugerida: '¿Ha estado en contacto con alguien con tuberculosis?'
    conjuntosPalabrasClave:
    - palabras:
      - contact
    - palabras:
      - tuberculos
    - palabras:
      - vecino
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: 'Mi vecino tuvo tuberculosis hace unos meses.'
    esPreguntaClave: 1
  - idPregunta: tbc_fiebre
    preguntaSugerida: '¿Tiene fiebre?'
    conjuntosPalabrasClave:
    - palabras:
      - fiebr
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: 'En las tardes me siento afiebrado.'
    esPreguntaClave: 1
  - idPregunta: tbc_hacinamiento
    preguntaSugerida: '¿Vive con muchas personas en su casa?'
    conjuntosPalabrasClave:
    - palabras:
      - personas
      - casa
    - palabras:
      - hacinamiento
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: 'Sí, somos siete en una casa chica.'
    esPreguntaClave: 1
  respuestaGenericaSinMatch: 'No estoy segura de a qué se refiere con eso.'
  diagnosticoEsperado: 'Tuberculosis pulmonar activa.'
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - tuberculosis
  - palabras:
    - tbc
  - palabras:
    - bacilo
  accionesCriticas:
  - descripcion: 'Instaurar aislamiento respiratorio apenas se sospecha'
    tipo: 4
    idReferencia: 'manejo_aislamiento_respiratorio'
    peso: 50
  - descripcion: 'Reconocer que es una enfermedad de notificación obligatoria'
    tipo: 4
    idReferencia: 'reconocer_notificacion_obligatoria'
    peso: 50
  erroresFrecuentes:
  - descripcion: 'No indagar el contacto epidemiológico'
    idReferenciaCondicion: 'omitio:tbc_contacto'
    retroalimentacion: 'El antecedente de contacto con un caso confirmado es determinante para la sospecha diagnóstica.'
  - descripcion: 'No indagar el hacinamiento'
    idReferenciaCondicion: 'omitio:tbc_hacinamiento'
    retroalimentacion: 'El hacinamiento es un factor de riesgo y de transmisión intradomiciliaria que orienta el estudio de contactos.'
  - descripcion: 'Omitir preguntar por hemoptisis'
    idReferenciaCondicion: 'omitio:tbc_hemoptisis'
    retroalimentacion: 'La hemoptisis, aunque poco frecuente, es un dato de alarma y de alta especificidad en este contexto.'
  - descripcion: 'No usar EPP (mascarilla de alta eficiencia) antes de examinar'
    idReferenciaCondicion: ''
    retroalimentacion: 'Ante la sospecha de TBC bacilífera, la protección respiratoria del examinador debe colocarse ANTES del contacto.'
  datosAdministrativos:
    nombrePacienteFicticio: 'Muñoz Paredes, Carlos'
    sexoPaciente: Masculino
    edadPaciente: '34 años'
    nombreEstablecimiento: 'Hospital Regional Simulado — Servicio de Urgencias'
