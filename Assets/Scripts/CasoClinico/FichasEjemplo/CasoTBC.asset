%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoTBC
  m_EditorClassIdentifier: 
  idCaso: CASO-TBC
  nombreCaso: Tuberculosis pulmonar
  motivoConsulta: Llevo varias semanas con una tos que no se me quita, y he bajado
    de peso sin querer.
  antecedentesRelevantes:
  - Contacto reciente con persona con TBC confirmada.
  - Hacinamiento en el domicilio.
  - "Sin antecedente documentado de vacunaci\xF3n BCG."
  signosVitales:
    frecuenciaCardiaca: 95
    frecuenciaRespiratoria: 20
    presionArterial: 110/70
    saturacionO2: 96
    temperatura: 37.8
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: "Adenopat\xEDas cervicales palpables, no dolorosas."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax anterior"
    hallazgoTexto: "Murmullo pulmonar disminuido en los v\xE9rtices."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax posterior"
    hallazgoTexto: "Cr\xE9pitos en los v\xE9rtices, matidez apical."
    esHallazgoRelevante: 1
  - regionAnatomica: Precordio
    hallazgoTexto: Sin alteraciones.
    esHallazgoRelevante: 0
  - regionAnatomica: Abdomen
    hallazgoTexto: Sin hallazgos relevantes.
    esHallazgoRelevante: 0
  - regionAnatomica: Extremidades
    hallazgoTexto: "P\xE9rdida de masa muscular, aspecto caqu\xE9ctico."
    esHallazgoRelevante: 1
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: "Palidez, mucosas secas; refiere sudoraci\xF3n nocturna."
    esHallazgoRelevante: 1
  examenesDisponibles:
  - nombreExamen: Baciloscopia
    resultado: "Positiva (++), presencia de bacilos \xE1cido-alcohol resistentes."
    clasificacion: 1
  - nombreExamen: "Cultivo de expectoraci\xF3n"
    resultado: Positivo para Mycobacterium tuberculosis (resultado diferido).
    clasificacion: 1
  - nombreExamen: "Radiograf\xEDa de t\xF3rax"
    resultado: "Infiltrado cavitado en l\xF3bulo superior derecho."
    clasificacion: 1
  - nombreExamen: PPD
    resultado: "Induraci\xF3n >15 mm, positiva."
    clasificacion: 1
  - nombreExamen: Hemograma
    resultado: Anemia leve (Hb aprox. 11 g/dL), sin leucocitosis.
    clasificacion: 2
  - nombreExamen: "Exploraci\xF3n cl\xEDnica del dolor"
    resultado: Sin dolor referido en reposo (EVA 0/10).
    clasificacion: 2
  preguntasClave:
  - idPregunta: tbc_hemoptisis
    preguntaSugerida: "\xBFHa notado sangre en el esputo?"
    conjuntosPalabrasClave:
    - palabras:
      - sangre
      - tos
    - palabras:
      - sangre
      - esputo
    - palabras:
      - sangre
      - flem
    - palabras:
      - hemoptisis
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, un par de veces vi como hilos de sangre."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: tbc_duracion_tos
    preguntaSugerida: "\xBFCu\xE1nto tiempo lleva con tos?"
    conjuntosPalabrasClave:
    - palabras:
      - cuanto
      - tos
    - palabras:
      - hace
      - tos
    - palabras:
      - tiempo
      - tos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: Como tres semanas; antes era seca y ahora sale con flema.
    esPreguntaClave: 1
    intencionesQueSatisface:
    - tiempo_evolucion
  - idPregunta: tbc_baja_peso
    preguntaSugerida: "\xBFHa bajado de peso?"
    conjuntosPalabrasClave:
    - palabras:
      - baj
      - peso
    - palabras:
      - adelgaz
    - palabras:
      - kilos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, unos cinco kilos sin hacer dieta."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: tbc_sudor_nocturno
    preguntaSugerida: "\xBFSuda en la noche?"
    conjuntosPalabrasClave:
    - palabras:
      - sud
      - noch
    - palabras:
      - empap
      - saban
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, a veces empapo las s\xE1banas."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: tbc_contacto
    preguntaSugerida: "\xBFHa estado en contacto con alguien con tuberculosis?"
    conjuntosPalabrasClave:
    - palabras:
      - contact
    - palabras:
      - tuberculos
    - palabras:
      - vecino
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: Mi vecino estuvo enfermo hace unos meses.
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: tbc_fiebre
    preguntaSugerida: "\xBFTiene fiebre?"
    conjuntosPalabrasClave:
    - palabras:
      - fiebr
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: En las tardes me siento afiebrado.
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: tbc_hacinamiento
    preguntaSugerida: "\xBFVive con muchas personas en su casa?"
    conjuntosPalabrasClave:
    - palabras:
      - personas
      - casa
    - palabras:
      - hacinamiento
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, somos siete en una casa chica."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  respuestaGenericaSinMatch: "Disculpe, no le entend\xED bien. \xBFMe lo puede preguntar
    de otra forma?"
  historia:
    inicio: Como tres semanas con la tos.
    evolucion: Antes era seca y ahora sale con flema.
    empeora: No refiere
    alivia: No refiere
    remedios: No refiere
    alergias: No refiere
    antecedentes: Estuve en contacto con un vecino que estuvo enfermo hace unos meses,
      y somos siete en una casa chica.
    habitos: No refiere
    intensidad: No refiere
    localizacion: No refiere
    sintomasAsociados: "He bajado unos cinco kilos sin hacer dieta, a veces empapo
      las s\xE1banas en la noche, me siento afiebrado en las tardes y un par de veces
      vi hilos de sangre."
    perfil: "Soy Carlos Mu\xF1oz, tengo 34 a\xF1os."
  diagnosticoEsperado: Tuberculosis pulmonar activa.
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - tuberculosis
  - palabras:
    - tbc
  - palabras:
    - bacilo
  accionesCriticas:
  - descripcion: Instaurar aislamiento respiratorio apenas se sospecha
    tipo: 4
    idReferencia: manejo_aislamiento_respiratorio
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - aisl
    - palabras:
      - n95
    - palabras:
      - presion
      - negativa
  - descripcion: "Reconocer que es una enfermedad de notificaci\xF3n obligatoria"
    tipo: 4
    idReferencia: reconocer_notificacion_obligatoria
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - notific
      - obligator
    - palabras:
      - notific
      - autoridad
    - palabras:
      - notific
      - seremi
    - palabras:
      - notific
      - epidemiolog
    - palabras:
      - declaracion
      - obligatoria
  erroresFrecuentes:
  - descripcion: "No indagar el contacto epidemiol\xF3gico"
    idReferenciaCondicion: omitio:tbc_contacto
    retroalimentacion: "El antecedente de contacto con un caso confirmado es determinante
      para la sospecha diagn\xF3stica."
  - descripcion: No indagar el hacinamiento
    idReferenciaCondicion: omitio:tbc_hacinamiento
    retroalimentacion: "El hacinamiento es un factor de riesgo y de transmisi\xF3n
      intradomiciliaria que orienta el estudio de contactos."
  - descripcion: Omitir preguntar por hemoptisis
    idReferenciaCondicion: omitio:tbc_hemoptisis
    retroalimentacion: La hemoptisis, aunque poco frecuente, es un dato de alarma
      y de alta especificidad en este contexto.
  - descripcion: No usar EPP (mascarilla de alta eficiencia) antes de examinar
    idReferenciaCondicion: 
    retroalimentacion: "Ante la sospecha de TBC bacil\xEDfera, la protecci\xF3n respiratoria
      del examinador debe colocarse ANTES del contacto."
  datosAdministrativos:
    nombrePacienteFicticio: "Mu\xF1oz Paredes, Carlos"
    sexoPaciente: Masculino
    edadPaciente: "34 a\xF1os"
    nombreEstablecimiento: "Hospital Regional Simulado \u2014 Servicio de Urgencias"
