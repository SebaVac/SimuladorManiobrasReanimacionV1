%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoSCA
  m_EditorClassIdentifier: 
  idCaso: CASO-SCA
  nombreCaso: "S\xEDndrome Coronario Agudo (STEMI)"
  motivoConsulta: Tengo un dolor fuerte en el pecho que se me corre al brazo izquierdo,
    hace como media hora.
  antecedentesRelevantes:
  - "Hipertensi\xF3n arterial, diabetes, dislipidemia."
  - Tabaquismo.
  - "Infarto agudo de miocardio previo (hace 2 a\xF1os)."
  signosVitales:
    frecuenciaCardiaca: 105
    frecuenciaRespiratoria: 22
    presionArterial: 150/95
    saturacionO2: 94
    temperatura: 36.6
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: "Sudoraci\xF3n profusa, palidez facial."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax anterior"
    hallazgoTexto: Sin hallazgos auscultatorios pulmonares relevantes.
    esHallazgoRelevante: 0
  - regionAnatomica: "T\xF3rax posterior"
    hallazgoTexto: Murmullo pulmonar conservado.
    esHallazgoRelevante: 0
  - regionAnatomica: Precordio
    hallazgoTexto: "Dolor variable a la palpaci\xF3n, cuarto ruido (S4) audible."
    esHallazgoRelevante: 1
  - regionAnatomica: Abdomen
    hallazgoTexto: "Refiere n\xE1useas; sin hallazgos f\xEDsicos relevantes."
    esHallazgoRelevante: 1
  - regionAnatomica: Extremidades
    hallazgoTexto: "Piel fr\xEDa; pulsos perif\xE9ricos conservados (disminuidos
      si hay compromiso hemodin\xE1mico)."
    esHallazgoRelevante: 1
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: "Palidez, sudoraci\xF3n fr\xEDa."
    esHallazgoRelevante: 1
  examenesDisponibles:
  - nombreExamen: Electrocardiograma
    resultado: Supradesnivel del segmento ST en derivaciones anteriores.
    clasificacion: 1
  - nombreExamen: Troponina
    resultado: Troponina elevada, con curva ascendente.
    clasificacion: 1
  - nombreExamen: "Exploraci\xF3n cl\xEDnica del dolor"
    resultado: Dolor retroesternal opresivo, EVA 8/10.
    clasificacion: 1
  - nombreExamen: Glicemia
    resultado: Elevada (aprox. 210 mg/dL).
    clasificacion: 2
  preguntasClave:
  - idPregunta: sca_inicio_dolor
    preguntaSugerida: "\xBFCu\xE1ndo comenz\xF3 el dolor?"
    conjuntosPalabrasClave:
    - palabras:
      - cuando
      - dol
    - palabras:
      - empez
      - dol
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: Hace unos 30 minutos, de repente.
    esPreguntaClave: 1
  - idPregunta: sca_caracteristica_dolor
    preguntaSugerida: "\xBFC\xF3mo describe el dolor?"
    conjuntosPalabrasClave:
    - palabras:
      - como
      - dol
    - palabras:
      - opresivo
    - palabras:
      - peso
      - pecho
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: Como un peso fuerte en el pecho, opresivo.
    esPreguntaClave: 1
  - idPregunta: sca_irradiacion
    preguntaSugerida: "\xBFEl dolor se corre a alg\xFAn lado?"
    conjuntosPalabrasClave:
    - palabras:
      - dol
      - irradia
    - palabras:
      - dol
      - corre
    - palabras:
      - dol
      - brazo
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, al brazo izquierdo y al cuello."
    esPreguntaClave: 1
  - idPregunta: sca_sintomas_asociados
    preguntaSugerida: "\xBFHa tenido n\xE1useas o sudoraci\xF3n?"
    conjuntosPalabrasClave:
    - palabras:
      - nause
    - palabras:
      - sud
    - palabras:
      - vomit
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, estoy sudando fr\xEDo y con ganas de vomitar."
    esPreguntaClave: 1
  - idPregunta: sca_antecedente_cardiaco
    preguntaSugerida: "\xBFAntecedentes de enfermedades del coraz\xF3n?"
    conjuntosPalabrasClave:
    - palabras:
      - cardi
    - palabras:
      - corazon
    - palabras:
      - infarto
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Tuve un infarto hace dos a\xF1os."
    esPreguntaClave: 1
  - idPregunta: sca_factores_riesgo
    preguntaSugerida: "\xBFEs hipertenso, diab\xE9tico o fuma?"
    conjuntosPalabrasClave:
    - palabras:
      - hipertens
    - palabras:
      - diabet
    - palabras:
      - fum
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, soy hipertenso y diab\xE9tico, y fumo."
    esPreguntaClave: 1
  - idPregunta: sca_relacion_reposo
    preguntaSugerida: "\xBFEl dolor cede con el reposo?"
    conjuntosPalabrasClave:
    - palabras:
      - dol
      - repos
    - palabras:
      - cede
      - repos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: No, sigue igual aunque estoy sentado.
    esPreguntaClave: 1
  respuestaGenericaSinMatch: "No estoy segura de a qu\xE9 se refiere con eso."
  diagnosticoEsperado: "S\xEDndrome Coronario Agudo con supradesnivel del ST (IAM
    tipo STEMI)."
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - infarto
  - palabras:
    - sca
  - palabras:
    - sindrome
    - coronario
  - palabras:
    - stemi
  accionesCriticas:
  - descripcion: "ECG de 12 derivaciones dentro de los primeros 10 minutos, monitorizaci\xF3n
      continua y v\xEDa venosa permeable"
    tipo: 4
    idReferencia: manejo_ecg_monitor_via
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - ecg
      - monitor
    - palabras:
      - ecg
      - venos
    - palabras:
      - ecg
      - derivaciones
    - palabras:
      - electrocardiograma
      - monitor
    - palabras:
      - electrocardiograma
      - venos
    - palabras:
      - electrocardiograma
      - derivaciones
  - descripcion: "Activar el protocolo de reperfusi\xF3n / traslado oportuno"
    tipo: 4
    idReferencia: manejo_activar_reperfusion
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - reperfusion
    - palabras:
      - trombolis
    - palabras:
      - trombolit
    - palabras:
      - fibrinolis
    - palabras:
      - angioplast
    - palabras:
      - hemodinamia
    - palabras:
      - cateteris
  erroresFrecuentes:
  - descripcion: "No preguntar por la irradiaci\xF3n del dolor"
    idReferenciaCondicion: omitio:sca_irradiacion
    retroalimentacion: "La irradiaci\xF3n a brazo izquierdo, cuello o mand\xEDbula
      aumenta la probabilidad de origen isqu\xE9mico."
  - descripcion: "No preguntar por la duraci\xF3n exacta del dolor"
    idReferenciaCondicion: omitio:sca_inicio_dolor
    retroalimentacion: "El tiempo de evoluci\xF3n define la ventana de reperfusi\xF3n
      y la urgencia del traslado."
  - descripcion: No tomar el ECG de forma oportuna
    idReferenciaCondicion: omitio:Electrocardiograma
    retroalimentacion: "El ECG de 12 derivaciones debe realizarse dentro de los primeros
      10 minutos ante todo dolor tor\xE1cico sugerente."
  - descripcion: No cuantificar la intensidad del dolor (EVA)
    idReferenciaCondicion: "omitio:Exploraci\xF3n cl\xEDnica del dolor"
    retroalimentacion: "La EVA permite objetivar el dolor, seguir la respuesta al
      tratamiento y priorizar la atenci\xF3n."
  datosAdministrativos:
    nombrePacienteFicticio: "Alarc\xF3n Bravo, Jorge"
    sexoPaciente: Masculino
    edadPaciente: "59 a\xF1os"
    nombreEstablecimiento: "Hospital Regional Simulado \u2014 Servicio de Urgencias"
