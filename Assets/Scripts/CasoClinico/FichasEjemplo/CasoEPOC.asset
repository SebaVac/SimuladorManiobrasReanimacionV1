%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoEPOC
  m_EditorClassIdentifier: 
  idCaso: CASO-EPOC
  nombreCaso: "Exacerbaci\xF3n de EPOC"
  motivoConsulta: "Llevo a\xF1os con tos, pero ahora me cuesta respirar mucho m\xE1s
    que antes, se me agrav\xF3."
  antecedentesRelevantes:
  - "Tabaquismo de larga data (\u224830 paquetes/a\xF1o)."
  - Exacerbaciones previas de EPOC.
  - "Posible exposici\xF3n ocupacional a humo o polvo."
  signosVitales:
    frecuenciaCardiaca: 100
    frecuenciaRespiratoria: 24
    presionArterial: 130/85
    saturacionO2: 89
    temperatura: 36.5
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: "Respiraci\xF3n con labios fruncidos."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax anterior"
    hallazgoTexto: "T\xF3rax en tonel, murmullo disminuido, sibilancias espiratorias."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax posterior"
    hallazgoTexto: "Hipersonoridad a la percusi\xF3n, roncus."
    esHallazgoRelevante: 1
  - regionAnatomica: Precordio
    hallazgoTexto: "Ruidos card\xEDacos alejados por hiperinsuflaci\xF3n."
    esHallazgoRelevante: 1
  - regionAnatomica: Abdomen
    hallazgoTexto: Sin hallazgos relevantes.
    esHallazgoRelevante: 0
  - regionAnatomica: Extremidades
    hallazgoTexto: Sin edema (salvo cor pulmonale asociado).
    esHallazgoRelevante: 0
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: "Coloraci\xF3n rosada-gris\xE1cea, sin cianosis franca."
    esHallazgoRelevante: 1
  examenesDisponibles:
  - nombreExamen: "Espirometr\xEDa"
    resultado: "Patr\xF3n obstructivo, VEF1/CVF < 0,70 post-broncodilatador."
    clasificacion: 1
  - nombreExamen: Gases arteriales
    resultado: Hipoxemia leve-moderada, PaCO2 normal o levemente elevada.
    clasificacion: 1
  - nombreExamen: "Radiograf\xEDa de t\xF3rax"
    resultado: "Hiperinsuflaci\xF3n, aplanamiento diafragm\xE1tico."
    clasificacion: 1
  - nombreExamen: "Exploraci\xF3n cl\xEDnica del dolor"
    resultado: Sin dolor referido en reposo (EVA 0/10).
    clasificacion: 2
  preguntasClave:
  - idPregunta: epoc_duracion_tos
    preguntaSugerida: "\xBFHace cu\xE1nto tiempo tiene tos?"
    conjuntosPalabrasClave:
    - palabras:
      - hace
      - tos
    - palabras:
      - "a\xF1os"
      - tos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Hace a\xF1os; tos de fumador le dicen."
    esPreguntaClave: 1
    intencionesQueSatisface:
    - tiempo_evolucion
  - idPregunta: epoc_tabaquismo
    preguntaSugerida: "\xBFFuma o ha fumado? \xBFCu\xE1nto?"
    conjuntosPalabrasClave:
    - palabras:
      - fum
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Fum\xE9 como 30 a\xF1os, un paquete al d\xEDa."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epoc_expectoracion
    preguntaSugerida: "\xBFLa tos tiene flema?"
    conjuntosPalabrasClave:
    - palabras:
      - tos
      - flem
    - palabras:
      - flem
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, en las ma\xF1anas boto harta flema."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epoc_disnea_esfuerzo
    preguntaSugerida: "\xBFHa notado que se cansa m\xE1s al hacer esfuerzo?"
    conjuntosPalabrasClave:
    - palabras:
      - cansa
      - esfuerzo
    - palabras:
      - fatiga
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, ya no puedo subir escaleras como antes."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epoc_baja_peso
    preguntaSugerida: "\xBFHa bajado de peso?"
    conjuntosPalabrasClave:
    - palabras:
      - baj
      - peso
    - palabras:
      - adelgaz
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Un poco, s\xED."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epoc_exacerbaciones
    preguntaSugerida: "\xBFHa tenido episodios similares antes?"
    conjuntosPalabrasClave:
    - palabras:
      - episodio
      - antes
    - palabras:
      - recaida
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, esta es como la tercera vez que me pasa esto."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  respuestaGenericaSinMatch: "Disculpe, no le entend\xED bien. \xBFMe lo puede preguntar
    de otra forma?"
  historia:
    inicio: "Llevo a\xF1os con tos; ahora me cuesta respirar mucho m\xE1s que antes."
    evolucion: "Se me agrav\xF3; ya no puedo subir escaleras como antes."
    empeora: "Me canso m\xE1s cuando hago esfuerzo; ya no puedo subir escaleras como
      antes."
    alivia: No refiere
    remedios: No refiere
    alergias: No refiere
    antecedentes: Esta es como la tercera vez que me pasa esto.
    habitos: "Fum\xE9 como 30 a\xF1os, un paquete al d\xEDa."
    intensidad: "Me cuesta respirar mucho m\xE1s que antes."
    localizacion: No refiere
    sintomasAsociados: "Boto harta flema en las ma\xF1anas y he bajado un poco de
      peso."
    perfil: "Soy Manuel Rojas, tengo 64 a\xF1os."
  diagnosticoEsperado: "Exacerbaci\xF3n de Enfermedad Pulmonar Obstructiva Cr\xF3nica
    (EPOC)."
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - epoc
  - palabras:
    - exacerbacion
    - epoc
  - palabras:
    - obstructiva
    - cronica
  accionesCriticas:
  - descripcion: "Valorar patr\xF3n respiratorio y titular O2 con cautela (evitar
      hiperoxia en retenedores de CO2)"
    tipo: 4
    idReferencia: manejo_o2_titulado
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - oxigen
      - titul
    - palabras:
      - oxigen
      - cautela
    - palabras:
      - oxigen
      - controlad
    - palabras:
      - oxigen
      - venturi
    - palabras:
      - o2
      - titul
    - palabras:
      - o2
      - cautela
    - palabras:
      - o2
      - controlad
    - palabras:
      - o2
      - venturi
    - palabras:
      - venturi
    - palabras:
      - 88
      - 92
  - descripcion: Reconocer necesidad de broncodilatadores y valorar fatiga respiratoria
    tipo: 4
    idReferencia: manejo_broncodilatadores
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - broncodilat
    - palabras:
      - salbutamol
    - palabras:
      - ipratropio
    - palabras:
      - nebuliz
  erroresFrecuentes:
  - descripcion: "No indagar la historia tab\xE1quica"
    idReferenciaCondicion: omitio:epoc_tabaquismo
    retroalimentacion: "Cuantificar el tabaquismo (paquetes/a\xF1o) es esencial para
      el diagn\xF3stico y el pron\xF3stico de la EPOC."
  - descripcion: No indagar exacerbaciones previas
    idReferenciaCondicion: omitio:epoc_exacerbaciones
    retroalimentacion: La frecuencia de exacerbaciones define el fenotipo y la gravedad
      del paciente EPOC.
  - descripcion: "Administrar ox\xEDgeno a alto flujo sin control"
    idReferenciaCondicion: 
    retroalimentacion: "En el retenedor de CO2 la hiperoxia puede deprimir el est\xEDmulo
      respiratorio; titular O2 a una SatO2 objetivo de 88-92%."
  datosAdministrativos:
    nombrePacienteFicticio: Rojas Vidal, Manuel
    sexoPaciente: Masculino
    edadPaciente: "64 a\xF1os"
    nombreEstablecimiento: "Hospital Regional Simulado \u2014 Servicio de Urgencias"
