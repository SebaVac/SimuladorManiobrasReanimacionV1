%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoSARS
  m_EditorClassIdentifier: 
  idCaso: CASO-SARS
  nombreCaso: "S\xEDndrome Respiratorio Agudo Grave (SARS)"
  motivoConsulta: "Tengo fiebre, me duele todo el cuerpo y hace unos d\xEDas que
    me cuesta respirar."
  antecedentesRelevantes:
  - Viaje reciente a zona con brote activo (o contacto con caso confirmado).
  - Sin comorbilidades relevantes.
  signosVitales:
    frecuenciaCardiaca: 105
    frecuenciaRespiratoria: 26
    presionArterial: 115/75
    saturacionO2: 90
    temperatura: 38.2
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: "Refiere cefalea; sin adenopat\xEDas."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax anterior"
    hallazgoTexto: Taquipnea, leve uso de musculatura accesoria.
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax posterior"
    hallazgoTexto: "Cr\xE9pitos difusos bilaterales."
    esHallazgoRelevante: 1
  - regionAnatomica: Precordio
    hallazgoTexto: Taquicardia sinusal.
    esHallazgoRelevante: 1
  - regionAnatomica: Abdomen
    hallazgoTexto: Sin hallazgos relevantes.
    esHallazgoRelevante: 0
  - regionAnatomica: Extremidades
    hallazgoTexto: Refiere mialgias; sin edema.
    esHallazgoRelevante: 1
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: "Cianosis peribucal leve; piel con calofr\xEDos."
    esHallazgoRelevante: 1
  examenesDisponibles:
  - nombreExamen: Hemograma
    resultado: Leucopenia con linfopenia.
    clasificacion: 1
  - nombreExamen: "Prote\xEDna C reactiva"
    resultado: Elevada.
    clasificacion: 1
  - nombreExamen: PCR viral / panel respiratorio
    resultado: PCR positiva para el agente causal.
    clasificacion: 1
  - nombreExamen: "Radiograf\xEDa de t\xF3rax"
    resultado: "Infiltrados bilaterales, patr\xF3n en vidrio esmerilado."
    clasificacion: 1
  - nombreExamen: "Tomograf\xEDa de t\xF3rax"
    resultado: Opacidades en vidrio esmerilado bilaterales.
    clasificacion: 2
  - nombreExamen: "Exploraci\xF3n cl\xEDnica del dolor"
    resultado: Sin dolor referido en reposo (EVA 0/10).
    clasificacion: 2
  preguntasClave:
  - idPregunta: sars_nexo
    preguntaSugerida: "\xBFHa viajado recientemente o tenido contacto con alguien
      enfermo?"
    conjuntosPalabrasClave:
    - palabras:
      - viaj
    - palabras:
      - contact
      - enferm
    - palabras:
      - brote
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Volv\xED hace una semana de un viaje donde hab\xEDa un brote."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: sars_fiebre
    preguntaSugerida: "\xBFTiene fiebre? \xBFDe cu\xE1nto?"
    conjuntosPalabrasClave:
    - palabras:
      - fiebr
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, como 38 grados, con calofr\xEDos."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: sars_mialgias
    preguntaSugerida: "\xBFLe duele el cuerpo?"
    conjuntosPalabrasClave:
    - palabras:
      - dol
      - cuerpo
    - palabras:
      - mialgia
    - palabras:
      - duel
      - cuerpo
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, todo el cuerpo, sobre todo las piernas."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: sars_cefalea
    preguntaSugerida: "\xBFLe duele la cabeza?"
    conjuntosPalabrasClave:
    - palabras:
      - dol
      - cabeza
    - palabras:
      - cefalea
    - palabras:
      - duel
      - cabeza
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, harto."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: sars_disnea
    preguntaSugerida: "\xBFHa notado que le cuesta respirar?"
    conjuntosPalabrasClave:
    - palabras:
      - cuesta
      - respir
    - palabras:
      - falta
      - aire
    - palabras:
      - disnea
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, sobre todo cuando camino."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: sars_tos
    preguntaSugerida: "\xBFHa tenido tos?"
    conjuntosPalabrasClave:
    - palabras:
      - tos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: Un poco, seca.
    esPreguntaClave: 1
    intencionesQueSatisface: []
  respuestaGenericaSinMatch: "Disculpe, no le entend\xED bien. \xBFMe lo puede preguntar
    de otra forma?"
  historia:
    inicio: "Hace unos d\xEDas que me cuesta respirar."
    evolucion: No refiere
    empeora: "Me cuesta m\xE1s respirar cuando camino."
    alivia: No refiere
    remedios: No refiere
    alergias: No refiere
    antecedentes: "No tengo otras enfermedades. Volv\xED hace una semana de un viaje
      donde hab\xEDa un brote."
    habitos: No refiere
    intensidad: La cabeza me duele harto.
    localizacion: "Me duele todo el cuerpo, sobre todo las piernas, y tambi\xE9n
      la cabeza."
    sintomasAsociados: "Tengo fiebre como de 38 grados con calofr\xEDos, dolor de
      cabeza y un poco de tos seca."
    perfil: "Soy Valentina Torres, tengo 29 a\xF1os."
  diagnosticoEsperado: "S\xEDndrome Respiratorio Agudo Grave (SARS)."
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - sars
  - palabras:
    - respiratorio
    - agudo
    - grave
  - palabras:
    - sindrome
    - respiratorio
  accionesCriticas:
  - descripcion: "Aislamiento / precauciones apenas se sospecha, con monitorizaci\xF3n
      continua de SatO2"
    tipo: 4
    idReferencia: manejo_aislamiento_monitor_sato2
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - aisl
      - saturacion
    - palabras:
      - aisl
      - sato2
    - palabras:
      - aisl
      - spo2
    - palabras:
      - aisl
      - saturometr
    - palabras:
      - aisl
      - oximetr
    - palabras:
      - aisl
      - monitor
  - descripcion: "Preparar manejo escalonado (oxigenoterapia y eventual intubaci\xF3n)"
    tipo: 4
    idReferencia: manejo_escalonado_via_aerea
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - intub
    - palabras:
      - ventilacion
      - mecanic
    - palabras:
      - vmni
    - palabras:
      - via
      - aerea
    - palabras:
      - escalonad
    - palabras:
      - alto
      - flujo
  erroresFrecuentes:
  - descripcion: "No indagar el nexo epidemiol\xF3gico"
    idReferenciaCondicion: omitio:sars_nexo
    retroalimentacion: El antecedente de viaje o contacto en contexto de brote es
      el dato que dispara las precauciones y el estudio dirigido.
  - descripcion: No valorar la cianosis ni la disnea progresiva
    idReferenciaCondicion: omitio:Piel y mucosas
    retroalimentacion: "La cianosis peribucal y la disnea de esfuerzo indican hipoxemia
      significativa y necesidad de ox\xEDgeno."
  - descripcion: Retrasar el inicio de la oxigenoterapia
    idReferenciaCondicion: 
    retroalimentacion: "Con SatO2 90% y disnea progresiva, la oxigenoterapia no debe
      esperar a la confirmaci\xF3n diagn\xF3stica."
  datosAdministrativos:
    nombrePacienteFicticio: "Torres D\xEDaz, Valentina"
    sexoPaciente: Femenino
    edadPaciente: "29 a\xF1os"
    nombreEstablecimiento: "Hospital Regional Simulado \u2014 Servicio de Urgencias"
