  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoBronquitisAguda
  m_EditorClassIdentifier: 
  idCaso: CASO-BRONQ
  nombreCaso: Bronquitis aguda
  motivoConsulta: "Tengo tos hace unos d\xEDas, al principio seca y ahora sale con
    flema, y me duele el pecho al toser."
  antecedentesRelevantes:
  - Tabaquismo activo.
  - "Cuadro viral / resfr\xEDo reciente o exposici\xF3n al fr\xEDo."
  signosVitales:
    frecuenciaCardiaca: 88
    frecuenciaRespiratoria: 18
    presionArterial: 118/76
    saturacionO2: 97
    temperatura: 37.6
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: "Congesti\xF3n nasal leve, faringe levemente eritematosa."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax anterior"
    hallazgoTexto: "Roncus difusos, sin signos de consolidaci\xF3n."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax posterior"
    hallazgoTexto: Murmullo conservado con roncus dispersos.
    esHallazgoRelevante: 1
  - regionAnatomica: Precordio
    hallazgoTexto: Sin alteraciones.
    esHallazgoRelevante: 0
  - regionAnatomica: Abdomen
    hallazgoTexto: Sin hallazgos relevantes.
    esHallazgoRelevante: 0
  - regionAnatomica: Extremidades
    hallazgoTexto: Mialgias leves, sin edema.
    esHallazgoRelevante: 0
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: Piel tibia, sin cianosis.
    esHallazgoRelevante: 0
  examenesDisponibles:
  - nombreExamen: "Radiograf\xEDa de t\xF3rax"
    resultado: "Sin infiltrados ni consolidaci\xF3n; campos pulmonares limpios (el
      diagn\xF3stico es principalmente cl\xEDnico)."
    clasificacion: 1
  - nombreExamen: "Exploraci\xF3n cl\xEDnica del dolor"
    resultado: Sin dolor referido en reposo (EVA 0/10).
    clasificacion: 2
  preguntasClave:
  - idPregunta: bronq_inicio_tos
    preguntaSugerida: "\xBFCu\xE1ndo comenz\xF3 la tos?"
    conjuntosPalabrasClave:
    - palabras:
      - cuando
      - tos
    - palabras:
      - empez
      - tos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Hace unos cinco d\xEDas."
    esPreguntaClave: 1
    intencionesQueSatisface:
    - tiempo_evolucion
  - idPregunta: bronq_tos_seca_a_productiva
    preguntaSugerida: "\xBFLa tos era seca al principio?"
    conjuntosPalabrasClave:
    - palabras:
      - tos
      - seca
    - palabras:
      - seca
      - flem
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, y ahora boto flema clara."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: bronq_dolor_toracico
    preguntaSugerida: "\xBFLe duele el pecho al toser?"
    conjuntosPalabrasClave:
    - palabras:
      - dol
      - pecho
    - palabras:
      - tensa
      - pecho
    - palabras:
      - duel
      - pecho
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, como que se me tensa el pecho."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: bronq_fiebre
    preguntaSugerida: "\xBFTiene fiebre?"
    conjuntosPalabrasClave:
    - palabras:
      - fiebr
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: Un poco, me he sentido afiebrado.
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: bronq_exposicion
    preguntaSugerida: "\xBFHa estado expuesto al fr\xEDo o resfriado recientemente?"
    conjuntosPalabrasClave:
    - palabras:
      - frio
    - palabras:
      - resfri
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, hace una semana andaba resfriado."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: bronq_tabaquismo
    preguntaSugerida: "\xBFFuma?"
    conjuntosPalabrasClave:
    - palabras:
      - fum
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, fumo desde hace varios a\xF1os."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  respuestaGenericaSinMatch: "Disculpe, no le entend\xED bien. \xBFMe lo puede preguntar
    de otra forma?"
  historia:
    inicio: "Empec\xE9 con tos hace unos cinco d\xEDas."
    evolucion: Al principio la tos era seca y ahora sale con flema clara.
    empeora: Cuando toso se me tensa el pecho.
    alivia: No refiere
    remedios: No refiere
    alergias: No refiere
    antecedentes: "Fumo y hace una semana andaba con un resfr\xEDo."
    habitos: "Fumo desde hace varios a\xF1os."
    intensidad: No refiere
    localizacion: Me duele el pecho.
    sintomasAsociados: Un poco de fiebre.
    perfil: "Soy Patricia Gonz\xE1lez, tengo 41 a\xF1os."
  diagnosticoEsperado: Bronquitis aguda.
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - bronquitis
  - palabras:
    - bronquitis
    - aguda
  accionesCriticas:
  - descripcion: "Diferenciar de neumon\xEDa descartando consolidaci\xF3n o signos
      de gravedad"
    tipo: 4
    idReferencia: manejo_descartar_neumonia
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - neumon
    - palabras:
      - radiografia
    - palabras:
      - consolidacion
  - descripcion: "Entregar indicaciones de automanejo y se\xF1ales de alarma para
      reconsultar"
    tipo: 4
    idReferencia: manejo_educacion_alarma
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - alarma
    - palabras:
      - reconsult
    - palabras:
      - automanejo
    - palabras:
      - educ
      - paciente
    - palabras:
      - volver
      - consultar
  erroresFrecuentes:
  - descripcion: "Indicar antibi\xF3ticos sin justificaci\xF3n"
    idReferenciaCondicion: 
    retroalimentacion: "La bronquitis aguda es habitualmente viral; el antibi\xF3tico
      no acorta el curso y expone a efectos adversos y resistencia."
  - descripcion: No indagar el consumo de tabaco ni educar sobre su abandono
    idReferenciaCondicion: omitio:bronq_tabaquismo
    retroalimentacion: "El tabaquismo perpet\xFAa la inflamaci\xF3n bronquial; la
      consulta aguda es una oportunidad para la intervenci\xF3n breve."
  datosAdministrativos:
    nombrePacienteFicticio: "Gonz\xE1lez Lagos, Patricia"
    sexoPaciente: Femenino
    edadPaciente: "41 a\xF1os"
    nombreEstablecimiento: "Hospital Regional Simulado \u2014 Servicio de Urgencias"
