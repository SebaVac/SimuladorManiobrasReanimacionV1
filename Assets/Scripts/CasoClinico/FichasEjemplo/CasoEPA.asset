%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0059c866089bbe24c9d13b586730ee9e, type: 3}
  m_Name: CasoEPA
  m_EditorClassIdentifier: 
  idCaso: CASO-EPA
  nombreCaso: "Edema Pulmonar Agudo (cardiog\xE9nico)"
  motivoConsulta: Me cuesta mucho respirar, siento que me ahogo, sobre todo cuando
    estoy acostado.
  antecedentesRelevantes:
  - "Insuficiencia card\xEDaca conocida."
  - "Hipertensi\xF3n arterial."
  - "Mal apego al tratamiento diur\xE9tico en los \xFAltimos d\xEDas."
  signosVitales:
    frecuenciaCardiaca: 118
    frecuenciaRespiratoria: 30
    presionArterial: 160/95
    saturacionO2: 87
    temperatura: 36.7
  hallazgosPorRegion:
  - regionAnatomica: Cabeza y cuello
    hallazgoTexto: "Ingurgitaci\xF3n yugular presente."
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax anterior"
    hallazgoTexto: Uso de musculatura accesoria, tiraje intercostal, taquipnea.
    esHallazgoRelevante: 1
  - regionAnatomica: "T\xF3rax posterior"
    hallazgoTexto: "Cr\xE9pitos bibasales bilaterales, matidez en las bases."
    esHallazgoRelevante: 1
  - regionAnatomica: Precordio
    hallazgoTexto: Taquicardia, tercer ruido (S3) audible.
    esHallazgoRelevante: 1
  - regionAnatomica: Abdomen
    hallazgoTexto: Reflujo hepatoyugular positivo.
    esHallazgoRelevante: 1
  - regionAnatomica: Extremidades
    hallazgoTexto: "Edema bilateral con signo de f\xF3vea en extremidades inferiores."
    esHallazgoRelevante: 1
  - regionAnatomica: Piel y mucosas
    hallazgoTexto: "Piel fr\xEDa y sudorosa, cianosis peribucal leve."
    esHallazgoRelevante: 1
  examenesDisponibles:
  - nombreExamen: "Radiograf\xEDa de t\xF3rax"
    resultado: "Infiltrado alveolar bilateral en \"alas de mariposa\", redistribuci\xF3n
      vascular, cardiomegalia."
    clasificacion: 1
  - nombreExamen: Electrocardiograma
    resultado: Taquicardia sinusal, signos de sobrecarga ventricular izquierda.
    clasificacion: 1
  - nombreExamen: BNP/NT-proBNP
    resultado: Elevado (>500 pg/mL).
    clasificacion: 1
  - nombreExamen: Troponina
    resultado: Levemente elevada.
    clasificacion: 1
  - nombreExamen: Ecocardiograma
    resultado: "FEVI reducida (~35%), disfunci\xF3n diast\xF3lica."
    clasificacion: 1
  - nombreExamen: Gases arteriales
    resultado: Hipoxemia (PaO2 aprox. 55 mmHg) con hipocapnia leve.
    clasificacion: 2
  - nombreExamen: "Funci\xF3n renal"
    resultado: Creatinina levemente elevada (1,4 mg/dL).
    clasificacion: 2
  - nombreExamen: "Exploraci\xF3n cl\xEDnica del dolor"
    resultado: Sin dolor referido en reposo (EVA 0/10).
    clasificacion: 2
  preguntasClave:
  - idPregunta: epa_inicio_disnea
    preguntaSugerida: "\xBFDesde cu\xE1ndo comenz\xF3 la dificultad para respirar?"
    conjuntosPalabrasClave:
    - palabras:
      - desde
      - respir
    - palabras:
      - hace
      - ahog
    - palabras:
      - empez
      - respir
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "Hace unas dos horas, y empeor\xF3 r\xE1pido."
    esPreguntaClave: 1
    intencionesQueSatisface:
    - tiempo_evolucion
  - idPregunta: epa_ortopnea
    preguntaSugerida: "\xBFLa dificultad empeora al acostarse?"
    conjuntosPalabrasClave:
    - palabras:
      - acost
      - respir
    - palabras:
      - acost
      - ahog
    - palabras:
      - dorm
      - almohad
    - palabras:
      - acost
      - dificult
    - palabras:
      - acost
      - empeor
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, tengo que dormir sentado con varias almohadas."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epa_dpn
    preguntaSugerida: "\xBFSe ha despertado en la noche con falta de aire?"
    conjuntosPalabrasClave:
    - palabras:
      - noch
      - ahog
    - palabras:
      - noch
      - aire
    - palabras:
      - despert
      - ahog
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, anoche me despert\xE9 sintiendo que me ahogaba."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epa_tos
    preguntaSugerida: "\xBFTiene tos? \xBFC\xF3mo es?"
    conjuntosPalabrasClave:
    - palabras:
      - tos
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, con una flema rosada y espumosa."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epa_cardiopatia
    preguntaSugerida: "\xBFTiene antecedentes de enfermedades del coraz\xF3n?"
    conjuntosPalabrasClave:
    - palabras:
      - cardi
    - palabras:
      - corazon
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, ya me hab\xEDan dicho que tengo problemas del coraz\xF3n."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epa_adherencia
    preguntaSugerida: "\xBFHa tomado sus medicamentos como corresponde?"
    conjuntosPalabrasClave:
    - palabras:
      - medic
    - palabras:
      - diuretic
    - palabras:
      - tratamiento
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "La verdad, se me olvid\xF3 tomar el diur\xE9tico estos \xFAltimos
      d\xEDas."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  - idPregunta: epa_edema
    preguntaSugerida: "\xBFHa notado hinchaz\xF3n en las piernas?"
    conjuntosPalabrasClave:
    - palabras:
      - hinch
    - palabras:
      - edema
    palabrasClave: []
    sinonimos: []
    respuestaPaciente: "S\xED, se me hincharon harto los pies."
    esPreguntaClave: 1
    intencionesQueSatisface: []
  respuestaGenericaSinMatch: "Disculpe, no le entend\xED bien. \xBFMe lo puede preguntar
    de otra forma?"
  historia:
    inicio: "Hace unas dos horas, y empeor\xF3 r\xE1pido."
    evolucion: "Fue empeorando r\xE1pido desde que empez\xF3."
    empeora: "Me ahogo m\xE1s cuando me acuesto; tengo que dormir sentada con varias
      almohadas."
    alivia: No refiere
    remedios: "Tengo un diur\xE9tico, pero estos \xFAltimos d\xEDas se me olvid\xF3
      tomarlo."
    alergias: No refiere
    antecedentes: "Tengo problemas del coraz\xF3n y la presi\xF3n alta."
    habitos: No refiere
    intensidad: Me cuesta mucho respirar, siento que me ahogo.
    localizacion: No refiere
    sintomasAsociados: Tengo tos con una flema rosada y espumosa, y se me hincharon
      harto los pies.
    perfil: "Soy Elena Sep\xFAlveda, tengo 68 a\xF1os."
  diagnosticoEsperado: "Edema pulmonar agudo de origen cardiog\xE9nico (descompensaci\xF3n
    de insuficiencia card\xEDaca)."
  conjuntosPalabrasClaveDiagnostico:
  - palabras:
    - edema
    - pulmonar
  - palabras:
    - edema
    - cardiogenic
  - palabras:
    - insuficiencia
    - cardiac
  accionesCriticas:
  - descripcion: "Ox\xEDgeno suplementario inmediato y posici\xF3n semisentada /
      Fowler alta"
    tipo: 4
    idReferencia: manejo_oxigeno_fowler
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - oxigen
      - fowler
    - palabras:
      - oxigen
      - semisent
    - palabras:
      - oxigen
      - sentad
    - palabras:
      - oxigen
      - sentar
    - palabras:
      - oxigen
      - incorpor
    - palabras:
      - oxigen
      - cabecera
    - palabras:
      - o2
      - fowler
    - palabras:
      - o2
      - semisent
    - palabras:
      - o2
      - sentad
    - palabras:
      - o2
      - sentar
    - palabras:
      - o2
      - incorpor
    - palabras:
      - o2
      - cabecera
  - descripcion: "Reconocer signos de sobrecarga de volumen (ingurgitaci\xF3n yugular,
      edema) como causa cardiog\xE9nica"
    tipo: 4
    idReferencia: reconocer_causa_cardiogenica
    peso: 50
    conjuntosPalabrasClave:
    - palabras:
      - cardiogenic
    - palabras:
      - insuficiencia
      - cardiac
    - palabras:
      - sobrecarga
      - volumen
    - palabras:
      - diuretic
    - palabras:
      - furosemida
    - palabras:
      - nitrato
    - palabras:
      - nitroglicerina
    - palabras:
      - restriccion
      - liquidos
  erroresFrecuentes:
  - descripcion: Omitir preguntar por ortopnea
    idReferenciaCondicion: omitio:epa_ortopnea
    retroalimentacion: "La ortopnea es un dato clave de congesti\xF3n pulmonar cardiog\xE9nica;
      siempre indagar la relaci\xF3n de la disnea con el dec\xFAbito."
  - descripcion: "Omitir preguntar por disnea parox\xEDstica nocturna"
    idReferenciaCondicion: omitio:epa_dpn
    retroalimentacion: "Despertar de noche con falta de aire orienta fuertemente
      a insuficiencia card\xEDaca izquierda descompensada."
  - descripcion: "No auscultar el t\xF3rax posterior"
    idReferenciaCondicion: "omitio:T\xF3rax posterior"
    retroalimentacion: "Los cr\xE9pitos bibasales bilaterales son un hallazgo central;
      auscultar ambos campos en su cara posterior."
  - descripcion: No valorar el edema de extremidades
    idReferenciaCondicion: omitio:Extremidades
    retroalimentacion: "El edema con f\xF3vea confirma sobrecarga de volumen y apoya
      el origen cardiog\xE9nico."
  - descripcion: "Confundir el cuadro con una infecci\xF3n respiratoria pura"
    idReferenciaCondicion: 
    retroalimentacion: "La ausencia de fiebre, la ortopnea, las yugulares ingurgitadas
      y el edema orientan a causa cardiog\xE9nica, no infecciosa."
  datosAdministrativos:
    nombrePacienteFicticio: "Sep\xFAlveda Rojas, Elena"
    sexoPaciente: Femenino
    edadPaciente: "68 a\xF1os"
    nombreEstablecimiento: "Hospital Regional Simulado \u2014 Servicio de Urgencias"
